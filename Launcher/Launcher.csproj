<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Probably Mod Manager</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.2.6</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><Compile Include="ManualHelper.cs" /><Compile Include="PublishingEngine.cs" /><Compile Include="PublishingMetadata.cs" /><Compile Include="PublishingAuthentication.cs" /><Compile Include="..\src\PublishingProtocol.cs" Link="PublishingProtocol.cs" /><Compile Include="..\src\RestartProtocol.cs" Link="RestartProtocol.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="WorkshopTags.seed.html" LogicalName="ProbablyModManager.WorkshopTagsSeed" /></ItemGroup>
</Project>
